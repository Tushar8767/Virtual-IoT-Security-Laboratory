# ============================================================
# Virtual IoT Security Laboratory — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=Virtual IoT Security Lab
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=iot_security_lab
MONGODB_MAX_POOL_SIZE=10

# --- MQTT Broker ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001
MQTT_CLIENT_ID_PREFIX=iot-lab-backend

# --- Security ---
# Used for internal API tokens (generate a strong random value)
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY_32_CHARS

# JWT settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Device Credential ---
# Master provisioning key used to issue device credentials
DEVICE_PROVISIONING_SECRET=CHANGE_ME_DEVICE_PROVISIONING_SECRET

# --- Telemetry Retention ---
# Max telemetry records per device before rotation
TELEMETRY_MAX_RECORDS_PER_DEVICE=1000
TELEMETRY_RETENTION_HOURS=24

# --- Detection Engine ---
AUTH_FAILURE_THRESHOLD=5
AUTH_FAILURE_WINDOW_SECONDS=60
TELEMETRY_RATE_THRESHOLD=10
TELEMETRY_RATE_WINDOW_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=60

# --- Simulation ---
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=15
DEFAULT_TELEMETRY_INTERVAL_SECONDS=10
